{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Control",
  "version": "2.0.0",
  "identifier": "dev.control.app",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix app run dev",
    "beforeBuildCommand": "npm --prefix app run build && npm --prefix app run bundle:helper"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Control",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "externalBin": ["control-elevate"]
  }
}
